<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="apptempo.MainPage"
             Title="Tempo Agora"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20" HorizontalOptions="Center">

            <Label Text="⛅ Tempo Agora"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#2C3E50"
                   HorizontalOptions="Center" />

            <Label Text="Consulte a previsão em tempo real"
                   FontSize="14"
                   TextColor="#7F8C8D"
                   HorizontalOptions="Center" />

            <Entry x:Name="txtCidade"
                   Placeholder="Digite o nome da cidade..."
                   WidthRequest="300"
                   FontSize="16" />

            <Button Text="Buscar Clima"
                    Clicked="OnBuscarClimaClicked"
                    BackgroundColor="#3498DB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    WidthRequest="200" />

            <ActivityIndicator x:Name="loadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#3498DB" />

            <!-- Atualizado de Frame para Border (.NET 9) -->
            <Border x:Name="borderResultado"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="20"
                    WidthRequest="320">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblCidade" FontSize="22" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center" />
                    <Label x:Name="lblCondicao" FontSize="16" TextColor="#E67E22" HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#ECF0F1" Margin="0,5" />

                    <Label x:Name="lblTemperatura" FontSize="16" TextColor="#34495E" />
                    <Label x:Name="lblVento" FontSize="16" TextColor="#34495E" />
                    <Label x:Name="lblVisibilidade" FontSize="16" TextColor="#34495E" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>